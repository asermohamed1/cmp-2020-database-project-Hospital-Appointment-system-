<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!--
            Database connection used by DBManager. Change Data Source to your
            SQL Server instance (e.g. .\SQLEXPRESS or localhost). This replaces
            the previously hard-coded, machine-specific connection string.
        -->
        <add name="HospitalAppointmentSystem"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=HospitalAppointmentSystem;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>