<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform data-access layer. Targets netstandard2.0 so it can be
    referenced by BOTH the legacy .NET Framework 4.7.2 WinForms app and modern
    .NET (e.g. the .NET 8 test project), giving the desktop app a single,
    parameterized, configuration-driven path to the database.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>HospitalAppointment.Data</RootNamespace>
    <AssemblyName>HospitalAppointment.Data</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
